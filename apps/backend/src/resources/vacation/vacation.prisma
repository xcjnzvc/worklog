model LeaveRequest {
    id        String        @id @default(uuid())
    userId    String // @map("user_id") 삭제 -> DB 컬럼명이 userId라면 OK
    companyId String
    type      LeaveType     @default(ANNUAL)
    startDate DateTime
    endDate   DateTime
    reason    String
    status    RequestStatus @default(PENDING)
    createdAt DateTime      @default(now())
    updatedAt DateTime?     @updatedAt

    user User @relation(fields: [userId], references: [id])

    // 승인자 관계
    approverId String?
    approver   User?   @relation("approver_relation", fields: [approverId], references: [id])

    // 테이블명도 대문자 시작인지 확인하세요! (예: LeaveRequest)
    @@map("LeaveRequest")
}

enum LeaveType {
    ANNUAL
    HALF_AM
    HALF_PM
}

enum RequestStatus {
    PENDING
    APPROVED
    REJECTED

    // Enum 타입 명칭도 DB와 맞춤
    @@map("RequestStatus")
}
