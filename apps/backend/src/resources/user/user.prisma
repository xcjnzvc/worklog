model User {
  id       String  @id @default(uuid())
  email    String  @unique
  password String
  name     String
  phone    String?
  role     Role    @default(USER)

  // position String? ← 제거
  positionId String? // ← 교체
  position   Position? @relation(fields: [positionId], references: [id]) // ← 교체

  companyId String
  teamId    String?

  workPolicyId String
  totalLeave   Int       @default(15)
  usedLeave    Float     @default(0.0)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?

  company    Company    @relation(fields: [companyId], references: [id])
  workPolicy WorkPolicy @relation(fields: [workPolicyId], references: [id])
  team       Team?      @relation(fields: [teamId], references: [id])

  workLogs         WorkLog[]
  approvedWorkLogs WorkLog[]      @relation("WorkLogApprover")
  leaveRequests    LeaveRequest[]
  approvedLeaves   LeaveRequest[] @relation("approver_relation")
  payments         Payment[]

  @@map("User")
}

model Team {
  id        String  @id @default(uuid())
  name      String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  users     User[]

  @@map("Team")
}

enum Role {
  OWNER
  ADMIN
  USER
  SUPER_ADMIN

  @@map("Role")
}
