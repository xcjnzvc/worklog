model User {
    id           String    @id @default(uuid())
    email        String    @unique
    password     String
    name         String
    phone        String?
    role         Role      @default(USER)
    companyId    String
    workPolicyId String
    totalLeave   Int       @default(15)
    usedLeave    Float     @default(0.0)
    createdAt    DateTime  @default(now())
    lastLoginAt  DateTime?

    company          Company          @relation(fields: [companyId], references: [id])
    workPolicy       WorkPolicy       @relation(fields: [workPolicyId], references: [id])
    workLogs         WorkLog[]
    leaveRequests    LeaveRequest[]
    workLogHistories WorkLogHistory[]

    approvedLeaves LeaveRequest[] @relation("approver_relation")

    // 테이블 이름 대문자 확인! (Supabase에 User라고 되어 있다면 아래 유지)
    @@map("User")
}

enum Role {
    OWNER
    ADMIN
    USER
    SUPER_ADMIN

    // DB에 정의된 enum 타입 이름이 "Role"이라면 대문자로 수정
    @@map("Role")
}
