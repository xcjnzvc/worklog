model WorkLog {
  id          String           @id @default(uuid())
  userId      String
  companyId   String
  clockIn     DateTime
  clockOut    DateTime?
  workMinutes Int?
  status      AttendanceStatus @default(NORMAL)
  isOvertime  Boolean          @default(false)
  date        DateTime         @db.Timestamp(3)
  createdAt   DateTime         @default(now())

  // --- 정정 신청 관련 필드 ---
  isFix       Boolean   @default(false)
  fixType     String? // 정정 분류 (LATE, ABSENT, EARLY, OTHER)
  fixReason   String? // 정정 사유
  fixClockIn  DateTime? // 수정 요청 출근 시간
  fixClockOut DateTime? // 수정 요청 퇴근 시간

  approverId String? // 결재권자 ID
  apprStatus ApprStatus? // 승인 상태 (PENDING, APPROVED, REJECTED)
  approver   User?       @relation("WorkLogApprover", fields: [approverId], references: [id])

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@map("WorkLog")
}

enum ApprStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  LATE_EARLY
  INSUFFICIENT
  MISSING_OUT
  ABSENT

  @@map("AttendanceStatus")
}
