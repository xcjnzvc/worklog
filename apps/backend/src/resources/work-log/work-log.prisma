// --- 근무 기록 ---
model WorkLog {
  id          String           @id @default(uuid())
  userId      String
  companyId   String
  clockIn     DateTime
  clockOut    DateTime?
  workMinutes Int?
  status      AttendanceStatus @default(NORMAL)
  isOvertime  Boolean          @default(false)
  date        DateTime         @db.Timestamp(3)
  createdAt   DateTime         @default(now())

  fixReason   String? // 수정 사유
  fixClockIn  DateTime?
  fixClockOut DateTime?
  isFix       Boolean   @default(false) // 수정 여부

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  // DB 테이블명이 대문자 "WorkLog"라면 아래처럼 맞춰주세요.
  @@map("WorkLog")
}

enum AttendanceStatus {
  NORMAL
  LATE
  EARLY_LEAVE
  LATE_EARLY
  INSUFFICIENT
  MISSING_OUT
  ABSENT

  @@map("AttendanceStatus")
}
